					text = <"Variable">
					description = <"HRV trend is highly variable.">
				>
				["at0230"] = <
					text = <"Positive impact">
					description = <"Sleep had positive impact on recovery.">
				>
				["at0231"] = <
					text = <"Neutral">
					description = <"Sleep had neutral impact on recovery.">
				>
				["at0232"] = <
