				>
				["at0244"] = <
					text = <"Exhausted">
					description = <"Feels exhausted.">
				>
				["at0250"] = <
					text = <"Upon waking">
					description = <"Measured upon waking.">
				>
				["at0251"] = <
					text = <"Pre-workout">
					description = <"Measured before workout.">
				>
				["at0252"] = <
					text = <"Post-workout">
					description = <"Measured after workout.">
				>
				["at0253"] = <
					text = <"End of day">
					description = <"Measured at end of day.">
				>
				["at0260"] = <
					text = <"HRV-based">
					description = <"Algorithm primarily based on HRV analysis.">
				>
				["at0261"] = <
					text = <"Multi-sensor fusion">
					description = <"Algorithm using multiple sensor inputs.">
				>
				["at0262"] = <
					text = <"Machine learning">
					description = <"Machine learning based algorithm.">
				>
				["at0263"] = <
					text = <"Subjective input weighted">
					description = <"Algorithm weighted by subjective inputs.">
				>
			>
		>
	>
	term_bindings = <
		["openEHR"] = <
			items = <
				-- Consumer wellness metric - no LOINC/SNOMED-CT codes available
