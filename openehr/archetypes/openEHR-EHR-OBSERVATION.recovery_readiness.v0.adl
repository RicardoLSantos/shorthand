				>
				["at0213"] = <
					text = <"Strained - light activity only">
					description = <"Only light activity recommended.">
				>
				["at0214"] = <
					text = <"Rest day recommended">
					description = <"Rest day recommended for recovery.">
				>
				["at0220"] = <
					text = <"Improving">
					description = <"HRV trend is improving.">
				>
