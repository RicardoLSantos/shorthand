	term_bindings = <
		["openEHR"] = <
			items = <
				-- NOTE (2026-07-15, re-verified against the terminology snapshots):
				-- The previous claim here -- "no LOINC/SNOMED-CT codes available" -- is
				-- FALSIFIED for total screen time. It was reached with an ANCHORED search
				-- (^"screen time"), which cannot match "Video, television or computer screen
				-- time" because that term does not START with "screen time". Searching
				-- unanchored and filtering afterwards finds a standard, active code.
				-- Local codes are retained below for the per-category breakdown, which has
				-- no published equivalent.
			>
		>
		["SNOMED-CT"] = <
			items = <
				["at0004"] = <[SNOMED-CT::2781000175103]>    -- Video, television or computer screen time (verified: Vocab2, std=S, Observable Entity, active, 2026-07-15)
			>
		>
	>
