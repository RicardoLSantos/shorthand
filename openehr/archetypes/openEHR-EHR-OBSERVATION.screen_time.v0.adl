archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.screen_time.v0

concept
	[at0000]	-- Screen time

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"Ricardo Lourenco dos Santos">
		["organisation"] = <"FMUP - Faculty of Medicine, University of Porto">
		["email"] = <"ricardolourencosantos@gmail.com">
		["date"] = <"2025-11-30">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record digital device usage and screen time data tracked by operating systems and digital wellness applications.">
			use = <"Use to record daily screen time, app usage patterns, and digital wellness metrics from smartphone and computer operating systems.">
			misuse = <"Not to be used for clinical assessment of technology addiction. Not intended for workplace productivity monitoring.">
			keywords = <"screen time", "digital wellness", "phone usage", "app usage", "smartphone", "digital health", "technology">
			copyright = <"Ricardo Lourenco dos Santos, FMUP, 2025. Creative Commons Attribution-ShareAlike 4.0.">
		>
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Faculty of Medicine, University of Porto (FMUP)">
	other_details = <
		["licence"] = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
		["custodian_organisation"] = <"FMUP - Faculty of Medicine, University of Porto">
		["references"] = <"Twenge JM, Campbell WK. Associations between screen time and lower psychological well-being among children and adolescents: Evidence from a population-based study. Prev Med Rep. 2018;12:271-283.

Elhai JD, Dvorak RD, Levine JC, Hall BJ. Problematic smartphone use: A conceptual overview and systematic review. J Affect Disord. 2017;207:251-259.">
		["current_contact"] = <"Ricardo Lourenco dos Santos <ricardolourencosantos@gmail.com>">
		["MD5-CAM-1.0.1"] = <"00000000000000000000000000000000">
	>

definition
	OBSERVATION[at0000] matches {	-- Screen time
		data matches {
			HISTORY[at0001] matches {	-- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Total screen time
										value matches {
											DV_DURATION matches {
												value matches {PTHM/|PT0S..PT24H|}
											}
										}
									}
									CLUSTER[at0005] occurrences matches {0..1} matches {	-- By device
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0006] occurrences matches {0..1} matches {	-- Phone screen time
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0007] occurrences matches {0..1} matches {	-- Tablet screen time
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {	-- Computer screen time
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {	-- TV screen time
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
										}
									}
									CLUSTER[at0010] occurrences matches {0..1} matches {	-- By category
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0011] occurrences matches {0..1} matches {	-- Social media
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {	-- Entertainment
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {	-- Productivity
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {	-- Health and fitness
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {	-- Games
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {	-- Education
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {	-- Other
												value matches {
													DV_DURATION matches {
														value matches {PTHM/|PT0S..PT24H|}
													}
												}
											}
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {	-- Pickups
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..1000|}
											}
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {	-- Notifications received
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..2000|}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {	-- First pickup time
										value matches {
											DV_TIME matches {*}
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {	-- Last usage time
										value matches {
											DV_TIME matches {*}
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {	-- Screen-free time
										value matches {
											DV_DURATION matches {
												value matches {PTHM/|PT0S..PT24H|}
											}
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {	-- Downtime observed
										value matches {
											DV_BOOLEAN matches {
												value matches {True, False}
											}
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {	-- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0030] matches {	-- Protocol tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0031] occurrences matches {0..1} matches {	-- Tracking source
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0200,	-- iOS Screen Time
									at0201,	-- Android Digital Wellbeing
									at0202,	-- Third-party app
									at0203,	-- Computer tracking software
									at0204]	-- Self-reported
								}
							}
						}
					}
					ELEMENT[at0032] occurrences matches {0..1} matches {	-- Daily limit setting
						value matches {
							DV_DURATION matches {
								value matches {PTHM/|PT0S..PT24H|}
							}
						}
					}
					allow_archetype CLUSTER[at0033] occurrences matches {0..*} matches {	-- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

