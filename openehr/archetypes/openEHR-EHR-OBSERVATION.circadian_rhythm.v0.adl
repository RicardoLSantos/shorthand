					text = <"HRV-derived phase">
					description = <"Circadian phase derived from HRV patterns.">
				>
				["at0220"] = <
					text = <"Work day">
					description = <"Day with work or school obligations.">
				>
				["at0221"] = <
					text = <"Free day">
					description = <"Day without work or school obligations.">
				>
				["at0222"] = <
					text = <"Shift work day">
					description = <"Day with non-standard work hours.">
				>
				["at0223"] = <
					text = <"Travel day">
					description = <"Day involving time zone change.">
				>
				["at0230"] = <
					text = <"Actigraphy-based">
					description = <"Analysis based on activity/movement data.">
				>
				["at0231"] = <
					text = <"Sleep diary combined">
					description = <"Actigraphy combined with sleep diary data.">
				>
				["at0232"] = <
					text = <"MCTQ algorithm">
					description = <"Munich Chronotype Questionnaire algorithm.">
				>
				["at0233"] = <
					text = <"Cosinor analysis">
					description = <"Cosinor rhythm analysis method.">
				>
				["at0234"] = <
					text = <"Machine learning derived">
					description = <"Machine learning algorithm for circadian analysis.">
				>
			>
		>
	>
	term_bindings = <
		["openEHR"] = <
			items = <
				-- Consumer wellness metric - no LOINC/SNOMED-CT codes available
